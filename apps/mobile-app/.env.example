# ===========================================================================
# PLATAFORMA JAIRO O D C v10 — MOBILE-APP (Expo)
# Copie para .env e preencha com os valores do seu projeto Supabase.
# Tudo com prefixo EXPO_PUBLIC_ é embutido no bundle e visível no aparelho.
# ===========================================================================

# 🔵 SUPABASE — Conexão pública (RLS ativo).
EXPO_PUBLIC_SUPABASE_URL =
EXPO_PUBLIC_SUPABASE_ANON_KEY =

# ===========================================================================
# ⚠️ REMOVIDA NA v10 — E A REMOÇÃO É A CORREÇÃO:
#
#   EXPO_PUBLIC_API_URL
#     Existia porque o Painel de Engenharia do aplicativo precisava falar com as
#     rotas `/api/admin/*` do site: as operações exigiam a CHAVE MESTRA, e o
#     Desenvolvedor do app não tinha sessão nenhuma (a credencial dele era fixa
#     no código). Aquelas rotas não pediam identificação.
#
#     Na v10 o Desenvolvedor entra pelo Supabase como qualquer pessoa, e as
#     operações administrativas viraram funções no banco que conferem
#     `is_superuser()`. O aplicativo fala direto com o banco — não há mais rota
#     intermediária, nem host para configurar, nem o engano clássico de apontar
#     `localhost` no telemóvel (que é o próprio telemóvel).
#
# ⚠️ NUNCA declare SUPABASE_SERVICE_ROLE_KEY aqui. O mobile jamais usa a chave
#    mestra — ela ficaria dentro do APK, onde qualquer um a extrai.
#
# REMOVIDA NA v4 (nenhum código a lê):
#   EXPO_PUBLIC_POSTHOG_KEY      → analytics (PostHog)
# ===========================================================================
