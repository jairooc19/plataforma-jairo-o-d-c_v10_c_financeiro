# ===========================================================================
# PLATAFORMA JAIRO O D C v4 — MOBILE-APP (Expo)
# Copie para .env e preencha com os valores do seu projeto Supabase.
# Tudo com prefixo EXPO_PUBLIC_ é embutido no bundle e visível no aparelho.
# ===========================================================================

# 🔵 SUPABASE — Conexão pública (RLS ativo).
EXPO_PUBLIC_SUPABASE_URL = 
EXPO_PUBLIC_SUPABASE_ANON_KEY = 

# 🌐 URL da aplicação admin-web, usada pelo Core para chamar as API Routes.
#
# ⚠️ NUNCA "localhost" PARA USO EM APARELHO. No telemóvel, localhost é o próprio
#    telemóvel — não o seu PC. Use o IP da máquina na rede local ou a URL publicada:
#       ✅ http://192.168.1.3:3000        (desenvolvimento, aparelho na mesma rede)
#       ✅ https://<projeto>.vercel.app   (produção)
#       ❌ http://localhost:3000          (só funciona no navegador do próprio PC)
#
#    Sem ela o Painel de Engenharia do mobile não funciona: triagem de usuários,
#    gestão de empresas e ajustes globais exigem a service role, que só existe no
#    servidor do admin-web. O Meu Perfil NÃO depende dela (usa o Supabase direto).
EXPO_PUBLIC_API_URL = 

# ===========================================================================
# ⚠️ NUNCA declare SUPABASE_SERVICE_ROLE_KEY aqui. O mobile jamais usa
#    o cliente supabaseAdmin — a chave ficaria exposta no aparelho.
#
# REMOVIDAS NA v4 (não são mais lidas por nenhum código):
#   EXPO_PUBLIC_POSTHOG_KEY      → analytics (PostHog)
# ===========================================================================
