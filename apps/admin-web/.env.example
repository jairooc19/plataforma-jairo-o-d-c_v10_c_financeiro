# ===========================================================================
# PLATAFORMA JAIRO O D C v5 — ADMIN-WEB (Next.js)
# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# ===========================================================================

# 🔵 SUPABASE — Conexão pública (RLS ativo). Exposta ao navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔐 SUPABASE — Chave service role (bypassa RLS).
# ⚠️ NUNCA prefixe com NEXT_PUBLIC_. Usada só no servidor (Server Actions e API Routes).
SUPABASE_SERVICE_ROLE_KEY=

# 🌐 URL base usada pelo Core para falar com as API Routes desta aplicação.
# Em desenvolvimento: http://localhost:3000
EXPO_PUBLIC_API_URL=

# 🔑 GOOGLE OAUTH 2.0 — login do "Usuário Proprietário" (v5).
# Client ID de uma credencial "Aplicativo Web" do Google Cloud Console.
# Precisa ser O MESMO valor colado em Supabase > Authentication > Providers > Google:
# quem valida a assinatura do token do popup é o Supabase, contra este Client ID.
#
# No Google Cloud Console, a mesma credencial precisa autorizar:
#   - Origens JavaScript: http://localhost:3000 (e o domínio de produção)
#   - URI de redirecionamento: https://<seu-projeto>.supabase.co/auth/v1/callback
#
# ⚠️ Se ficar vazia, o login do Proprietário NÃO quebra: a tela troca o popup
# pelo redirecionamento conduzido pelo Supabase, que volta em /auth/google/callback.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ===========================================================================
# REMOVIDAS NA v4 (não configure — não são mais lidas por nenhum código):
#   RESEND_API_KEY               → envio de e-mail transacional (Resend)
#   NEXT_PUBLIC_POSTHOG_KEY      → analytics (PostHog)
#   NEXT_PUBLIC_POSTHOG_HOST     → analytics (PostHog)
#   POSTHOG_PERSONAL_API_KEY     → trilha de auditoria (PostHog)
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY → catraca anti-bot (Cloudflare Turnstile)
#   TURNSTILE_SECRET_KEY         → catraca anti-bot (Cloudflare Turnstile)
# ===========================================================================
