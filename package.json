{
  "name": "plataforma-jairo-o-d-c-v4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev -w @jairo/admin-web",
    "build:web": "npm run build -w @jairo/admin-web",
    "lint:web": "npm run lint -w @jairo/admin-web",
    "test": "node --test \"packages/core/**/*.test.ts\"",
    "modulos:verificar": "node scripts/verificar-modulos.mjs",
    "verificar": "npm run test && npm run modulos:verificar && npm run lint:web && npm run build:web"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "dependencies": {
    "@react-native-picker/picker": "2.11.4"
  }
}
